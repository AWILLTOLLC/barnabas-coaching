---
import Layout from '../layouts/Layout.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI Consulting for Seattle Small Businesses',
  serviceType: 'AI Consulting',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Barnabas Coaching',
    url: 'https://barnabas.coach',
  },
  areaServed: [
    { '@type': 'City', name: 'Seattle' },
    { '@type': 'City', name: 'Bellevue' },
    { '@type': 'City', name: 'Redmond' },
    { '@type': 'City', name: 'Kirkland' },
    { '@type': 'City', name: 'Tacoma' },
  ],
  description: 'Barnabas Coaching helps Seattle small businesses figure out what AI is worth doing. Honest advice from Microsoft veterans. AI Audit starts at $2,500.',
  offers: [
    {
      '@type': 'Offer',
      name: 'AI Audit',
      price: '2500',
      priceCurrency: 'USD',
    },
    {
      '@type': 'Offer',
      name: 'Coaching Retainer',
      price: '1500',
      priceCurrency: 'USD',
    },
  ],
};
---

<Layout
  title="AI Consultant for Seattle Small Businesses | Barnabas Coaching"
  description="Barnabas Coaching helps Seattle small businesses figure out what AI is worth doing. Honest advice from Microsoft veterans. AI Audit starts at $2,500."
  schema={pageSchema}
>
  <!-- Hero -->
  <section style="background:#0E1F3D" class="py-16 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">Seattle, WA</p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 max-w-3xl leading-tight">
        AI Consulting for Seattle Small Businesses
      </h1>
      <p class="text-lg max-w-2xl leading-relaxed mb-8" style="color:#8fa6c4">
        You've been hearing about AI for two years. You've probably tried a few things. Maybe some of it
        stuck, most of it didn't, and you're not sure what you're missing or whether you're missing
        anything at all.
      </p>
      <p class="text-lg max-w-2xl leading-relaxed mb-10" style="color:#8fa6c4">
        That's where we come in.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-4 rounded text-base font-semibold text-white transition-colors"
        style="background:#C08B3A"
        onmouseover="this.style.background='#D4A254'"
        onmouseout="this.style.background='#C08B3A'"
      >
        Book a Free Discovery Call
      </a>
    </div>
  </section>

  <!-- What we do -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">What We Do</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
        Not in general. For your business.
      </h2>
      <p class="text-gray-600 leading-relaxed mb-5 text-lg">
        Barnabas Coaching helps Seattle-area small businesses work out what AI is actually worth doing
        for their specific situation. Not based on what worked for someone else's company. For yours.
      </p>
      <p class="text-gray-600 leading-relaxed mb-5">
        We start with an AI Audit. We spend time understanding your business, your workflows, and where
        your people are spending time they shouldn't have to. For Seattle-area clients, that often means
        coming to your office — walking the floor, sitting with your team, seeing how work actually
        moves through your business. Then we tell you what AI can help with, what it can't, and what
        the realistic path forward looks like. No software to sell. No vendor relationships. No agenda
        beyond giving you a straight answer.
      </p>
      <p class="text-gray-600 leading-relaxed mb-5">
        The audit takes 7 to 10 days and costs $2,500.
      </p>
      <p class="text-gray-600 leading-relaxed">
        If you want to keep working together after that, we offer monthly advisory retainers at
        $1,500/month. Most clients use that time to work through implementation, troubleshoot what's
        not working, and figure out what to tackle next.
      </p>
    </div>
  </section>

  <!-- What the audit looks at -->
  <section class="bg-white border-t border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">The AI Audit</p>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
            What we look at
          </h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            We go through your workflows, your tools, and your team's day-to-day. We're looking for
            three things:
          </p>
          <ol class="space-y-4 mb-8">
            {[
              'Where are people doing repetitive work that software can handle?',
              'Where are decisions being made slowly because information is scattered?',
              'Where has AI already shown up in your industry, and is it working?',
            ].map((item, i) => (
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center text-sm font-bold text-white" style="background:#C08B3A">{i + 1}</span>
                <p class="text-gray-600 leading-relaxed pt-0.5">{item}</p>
              </li>
            ))}
          </ol>
          <p class="text-gray-600 leading-relaxed">
            You get a written report with specific recommendations, ranked by effort and impact. Not a
            slide deck full of buzzwords. An actual plan.
          </p>
        </div>

        <div class="space-y-4">
          {[
            {
              title: 'Intake interview',
              desc: 'A structured 90-minute conversation about your business, your team, your current tools, and your biggest pain points.',
            },
            {
              title: 'Workflow mapping',
              desc: 'We document your core processes to identify where time is being lost and where AI can compress or eliminate manual work.',
            },
            {
              title: 'Written assessment report',
              desc: 'Clear, jargon-free findings with specific recommendations. Written for an owner, not a CTO.',
            },
            {
              title: 'Prioritized recommendations',
              desc: 'A ranked action plan based on effort, impact, and your actual priorities. Not a list of everything AI can do.',
            },
            {
              title: 'Tool & vendor guidance',
              desc: 'Specific recommendations on what to use, with context on tradeoffs, costs, and implementation complexity.',
            },
            {
              title: 'Debrief call',
              desc: 'A final 60-minute call to walk through the report, answer questions, and align on next steps.',
            },
          ].map((item) => (
            <div class="flex gap-4 p-4 bg-stone-50 rounded-lg border border-gray-100">
              <span class="text-amber-600 flex-shrink-0 mt-0.5 font-bold">✓</span>
              <div>
                <p class="font-semibold text-slate-900 text-sm mb-1">{item.title}</p>
                <p class="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <div>
          <span class="text-4xl font-bold text-slate-900">$2,500</span>
          <span class="text-gray-500 ml-2">one-time</span>
        </div>
        <a
          href="/contact"
          class="inline-block px-6 py-3 rounded text-sm font-semibold text-white transition-colors"
          style="background:#0E1F3D"
          onmouseover="this.style.background='#1a3358'"
          onmouseout="this.style.background='#0E1F3D'"
        >
          Get Started →
        </a>
        <a
          href="/services"
          class="text-sm font-semibold transition-colors"
          style="color:#C08B3A"
          onmouseover="this.style.color='#D4A254'"
          onmouseout="this.style.color='#C08B3A'"
        >
          See all services →
        </a>
      </div>
    </div>
  </section>

  <!-- We show up in person -->
  <section class="bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">Local. Present. Accountable.</p>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
            We show up in person.
          </h2>
          <p class="text-gray-600 leading-relaxed mb-5">
            Most AI consultants are remote by default. We're not. If you're in Seattle, Bellevue,
            Redmond, Kirkland, or anywhere in the Puget Sound area, we can be in your office.
          </p>
          <p class="text-gray-600 leading-relaxed mb-5">
            Some of this work is better done in person: walking a workflow, sitting with your team,
            understanding how your business actually operates day-to-day rather than how it looks
            on a slide. When it makes sense, we're there.
          </p>
          <p class="text-gray-600 leading-relaxed">
            We're a local firm. We know this market, the industries that run it, and the business
            culture here. When you work with us, you're working with people who live and work in
            the same region you do.
          </p>
        </div>
        <div class="space-y-4">
          {[
            {
              label: 'In-person available',
              desc: 'On-site for the AI Audit when you\'re in the greater Seattle area. We come to you.',
            },
            {
              label: 'Direct access',
              desc: 'You work with Aaron and our team directly. No handoffs, no account managers between you and the people doing the work.',
            },
            {
              label: 'Clear communication',
              desc: 'Straightforward conversations about what we found, what it means, and what to do next. No jargon, no vague recommendations.',
            },
            {
              label: 'Local accountability',
              desc: 'We\'re building a practice here. Our reputation is tied to your results in a way that a remote vendor\'s simply isn\'t.',
            },
          ].map((item) => (
            <div class="flex gap-4 p-5 rounded-lg border border-gray-100 bg-stone-50">
              <span class="text-amber-600 flex-shrink-0 mt-0.5 font-bold">✓</span>
              <div>
                <p class="font-semibold text-slate-900 text-sm mb-1">{item.label}</p>
                <p class="text-sm text-gray-600 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">Who We Are</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
        Microsoft veterans. Real-world operators.
      </h2>
      <p class="text-gray-600 leading-relaxed mb-5">
        We're three former Microsoft veterans. Between us, we spent 25 years building and shipping
        technology at scale. For the last eight years we've been running a boutique IT consulting firm
        serving the biotech industry. We know what it looks like to actually deploy technology inside a
        real business, not just advise on it from the outside.
      </p>
      <p class="text-gray-600 leading-relaxed mb-5">
        Barnabas Coaching exists because we think small businesses are getting bad AI advice and we can
        do better.
      </p>
      <p class="text-gray-600 leading-relaxed">
        We work with businesses across Seattle, Bellevue, Redmond, Kirkland, and the broader Puget Sound
        area. In-person when it makes sense, remote when it doesn't.
      </p>
    </div>
  </section>

  <!-- Who this is for -->
  <section style="background:#0E1F3D" class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">Who This Is For</p>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mb-6">
            Small businesses who want a straight answer.
          </h2>
          <p class="leading-relaxed mb-5" style="color:#8fa6c4">
            Small businesses with 5 to 200 employees. Owner-operated or close to it. You know your
            business. You don't need us to explain what AI is. You need someone to look at your actual
            situation and tell you where it fits and where it doesn't.
          </p>
          <p class="leading-relaxed" style="color:#8fa6c4">
            If you're hoping AI will replace your entire staff or cut your costs in half overnight,
            we're probably not the right fit. If you want a realistic picture of what's possible and a
            clear starting point, we are.
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">Industries We Know</p>
          <p class="leading-relaxed mb-6" style="color:#8fa6c4">
            We know the Seattle market, the industries, and the kinds of businesses that make this
            region run.
          </p>
          <ul class="grid grid-cols-2 gap-2">
            {[
              'Professional services',
              'Construction',
              'Healthcare',
              'Hospitality',
              'Retail',
              'Manufacturing',
              'Biotech',
              'Technology',
            ].map((industry) => (
              <li class="flex gap-2 items-center text-sm" style="color:#8fa6c4">
                <span style="color:#C08B3A">→</span>
                {industry}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">Book a Discovery Call</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mb-5">
        The first conversation is free.
      </h2>
      <p class="text-gray-600 leading-relaxed mb-5">
        30 minutes. We'll ask about your business and you can ask us anything. No pitch, no pressure.
      </p>
      <p class="text-gray-600 leading-relaxed mb-8">
        If it seems like a fit, we'll talk about next steps. If it doesn't, we'll tell you that too.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-4 rounded text-base font-semibold text-white transition-colors"
        style="background:#C08B3A"
        onmouseover="this.style.background='#D4A254'"
        onmouseout="this.style.background='#C08B3A'"
      >
        Book a Discovery Call
      </a>
    </div>
  </section>
</Layout>
