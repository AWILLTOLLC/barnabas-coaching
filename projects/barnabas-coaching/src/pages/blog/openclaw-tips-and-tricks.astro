          class="text-xs font-semibold uppercase tracking-widest mb-6 inline-block transition-colors"
          style="color:#C08B3A"
          onmouseover="this.style.color='#D4A254'"
          onmouseout="this.style.color='#C08B3A'"
        >
          ← Blog
        </a>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-5 leading-tight">
          OpenClaw Tips and Tricks
        </h1>
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2">
            <div
              class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white flex-shrink-0"
