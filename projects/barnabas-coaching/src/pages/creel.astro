---
import Layout from '../layouts/Layout.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'OpenClaw Setup and Managed Hosting',
  serviceType: 'AI Agent Configuration & Managed Hosting',
  provider: {
    '@type': 'LocalBusiness',
    name: 'Barnabas Coaching',
    url: 'https://barnabas.coach',
  },
  areaServed: [
    { '@type': 'City', name: 'Seattle' },
    { '@type': 'City', name: 'Bellevue' },
    { '@type': 'City', name: 'Redmond' },
    { '@type': 'City', name: 'Kirkland' },
    { '@type': 'City', name: 'Tacoma' },
  ],
  description: 'Professional setup, configuration, and managed hosting for OpenClaw AI agent systems, with Creel for iOS and macOS as the user-friendly interface.',
};
---

<Layout
  title="Creel &amp; OpenClaw Services"
  description="Aaron Williams offers professional OpenClaw setup, configuration, and managed hosting — with Creel for iOS and macOS as your interface. Available locally and in person for Seattle-area businesses."
  schema={serviceSchema}
>
  <!-- Page Header -->
  <section style="background:#0E1F3D" class="py-16 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest mb-4" style="color:#C08B3A">AI Agents, Done Right</p>
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white mb-5 max-w-3xl">
        Your own AI agent system, configured and running.
      </h1>
      <p class="text-lg max-w-2xl leading-relaxed" style="color:#8fa6c4">
        OpenClaw is one of the most capable AI agent platforms available. Getting it set up correctly
        is a different skill than knowing what AI can do for your business. Aaron handles the setup and
        keeps it running — you focus on using it.
      </p>
    </div>
  </section>

  <!-- What is OpenClaw + Creel -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-serif text-3xl font-bold text-slate-900 mb-5">OpenClaw and Creel</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          OpenClaw is a personal AI agent system: a gateway that connects to your preferred AI models,
          runs custom agents for specific business tasks, integrates with the tools you already use, and
          keeps everything under your control. No black-box SaaS. Your data, your configuration, your agents.
        </p>
        <p class="text-gray-600 leading-relaxed mb-4">
          Creel is the iOS and macOS application Aaron built as a user-friendly front end for OpenClaw agents.
          Instead of a command line or a developer console, you get a clean, native app on your phone or Mac
          where your agents live and work.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          Together, they give you a private, configurable AI system you actually control — not a subscription
          seat in someone else's product.
        </p>

        <!-- Platform callout -->
        <div class="rounded-lg border border-amber-100 p-5" style="background:#fffbf5">
          <h3 class="font-semibold text-slate-900 mb-3 text-sm">What OpenClaw connects to</h3>
          <ul class="space-y-1.5">
            {[
              'Claude, GPT-4, Gemini, and local models',
              'iMessage, Signal, Telegram, Discord, Slack',
              'Calendar, email, and task tools',
              'Custom agents built for your specific workflows',
              'Your existing business systems via integrations',
            ].map((item) => (
              <li class="flex gap-3 items-start text-sm text-gray-700">
                <span class="text-amber-600 flex-shrink-0">→</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Why this matters -->
      <div class="space-y-6">
        <div class="bg-white rounded-lg border border-gray-200 p-6">
          <h3 class="font-semibold text-slate-900 mb-4">Why owner-operators care about this</h3>
          <ul class="space-y-4">
            {[
              {
                title: 'Control over your AI stack',
                desc: "Generic AI products are built for a median user. Your own OpenClaw instance is configured for your business, your workflows, and how you actually work.",
              },
              {
                title: 'Data stays yours',
                desc: "With a self-hosted or Aaron-managed instance, your conversations and business context aren't training someone else's model or sitting in a vendor's data lake.",
              },
              {
                title: 'Agents that do actual work',
                desc: "OpenClaw supports multi-step agents: research, draft, review, send. Not just a chat window — a system that completes tasks.",
              },
              {
                title: 'One interface for everything',
                desc: "Creel gives you a single app on your iPhone or Mac to interact with all your agents, across all your connected services.",
              },
            ].map((item) => (
              <li class="flex gap-3">
                <span class="text-amber-600 flex-shrink-0 mt-0.5">✓</span>
                <div>
                  <span class="font-medium text-slate-900 text-sm">{item.title}:</span>{' '}
                  <span class="text-sm text-gray-600">{item.desc}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <hr class="border-gray-200" />
  </div>

  <!-- Services: Setup + Hosted -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:#C08B3A">Two Ways to Work Together</p>
    <h2 class="font-serif text-3xl font-bold text-slate-900 mb-12">Services</h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

      <!-- Setup & Config -->
      <div class="bg-white rounded-lg border border-gray-200 p-8">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:#C08B3A">One-Time Engagement</p>
        <h3 class="font-serif text-2xl font-bold text-slate-900 mb-2">Setup &amp; Configuration</h3>
        <p class="text-sm text-gray-500 mb-5">On-site available for Seattle-area clients</p>
        <p class="text-gray-600 leading-relaxed mb-5">
          Aaron installs and configures OpenClaw for you — connecting your AI models, setting up the agents
          relevant to your workflows, integrating your tools, and making sure everything works. For Seattle-area
          clients, this can be done in person at your office.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          You also get Creel installed and configured on your devices so the whole system is accessible and
          usable on day one, not after a week of tinkering.
        </p>
        <h4 class="font-semibold text-slate-900 text-sm mb-3">Includes</h4>
        <ul class="space-y-2 mb-8">
          {[
            'OpenClaw installation and initial configuration',
            'AI model connections (Claude, GPT, or your preference)',
            'Agent setup for your priority workflows',
            'Tool and service integrations',
            'Creel setup on your Mac and/or iPhone',
            'Handoff session — you leave knowing how to use it',
            'Follow-up support window (30 days)',
          ].map((item) => (
            <li class="flex gap-3 items-start text-sm text-gray-700">
              <span class="text-amber-600 flex-shrink-0">→</span>
              {item}
            </li>
          ))}
        </ul>
        <a
          href="/contact"
          class="inline-block px-6 py-3 rounded text-sm font-semibold text-white transition-colors"
          style="background:#0E1F3D"
          onmouseover="this.style.background='#1a3358'"
          onmouseout="this.style.background='#0E1F3D'"
        >
          Talk Setup →
        </a>
      </div>

      <!-- Managed Hosting -->
      <div class="bg-white rounded-lg border border-gray-200 p-8">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:#C08B3A">Ongoing Service</p>
        <h3 class="font-serif text-2xl font-bold text-slate-900 mb-2">Managed Hosting &amp; Admin</h3>
        <p class="text-sm text-gray-500 mb-5">Monthly, no long-term contract required</p>
        <p class="text-gray-600 leading-relaxed mb-5">
          Aaron hosts and administers your OpenClaw instance. You don't touch the infrastructure — he keeps
          it updated, monitors it, and handles anything that breaks. You use Creel; he handles everything
          behind it.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          Good for business owners who want the capability without the technical overhead. Your AI system
          runs on reliable infrastructure, stays current, and has someone accountable for keeping it that way.
        </p>
        <h4 class="font-semibold text-slate-900 text-sm mb-3">Includes</h4>
        <ul class="space-y-2 mb-8">
          {[
            'Dedicated OpenClaw instance on managed infrastructure',
            'OpenClaw and dependency updates',
            'Uptime monitoring and incident response',
            'Configuration changes as your needs evolve',
            'New agent setup on request',
            'Monthly check-in on what\'s working and what isn\'t',
          ].map((item) => (
            <li class="flex gap-3 items-start text-sm text-gray-700">
              <span class="text-amber-600 flex-shrink-0">→</span>
              {item}
            </li>
          ))}
        </ul>
        <a
          href="/contact"
          class="inline-block px-6 py-3 rounded text-sm font-semibold text-white transition-colors"
          style="background:#0E1F3D"
          onmouseover="this.style.background='#1a3358'"
          onmouseout="this.style.background='#0E1F3D'"
        >
          Ask About Hosting →
        </a>
      </div>

    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <hr class="border-gray-200" />
  </div>

  <!-- Who this is for -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div>
        <h2 class="font-serif text-3xl font-bold text-slate-900 mb-5">Who this is for</h2>
        <p class="text-gray-600 leading-relaxed mb-4">
          OpenClaw is a developer-grade system. Most people who would benefit from it don't have the time
          or background to set it up and keep it running. That's the gap this service fills.
        </p>
        <p class="text-gray-600 leading-relaxed mb-6">
          If you're already curious about AI agents, want to run your own system, and want someone who built
          their own to set it up for you — this is the right fit.
        </p>
        <ul class="space-y-3">
          {[
            'Business owners who want a private AI system they control',
            'Teams using AI tools piecemeal and wanting them unified',
            'Anyone who tried setting up OpenClaw and got stuck',
            'Seattle-area clients who want in-person setup and training',
            'Operators who want the capability without the infrastructure work',
          ].map((item) => (
            <li class="flex gap-3 items-start text-gray-700">
              <span class="text-amber-600 flex-shrink-0 mt-0.5">→</span>
              <span class="text-sm">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Aaron's credentials for this -->
      <div class="rounded-lg border border-amber-100 p-7" style="background:#fffbf5">
        <h3 class="font-semibold text-slate-900 mb-4">Why Aaron, specifically</h3>
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          Aaron built Creel — the iOS and macOS interface for OpenClaw — and runs OpenClaw in his own practice
          daily. He doesn't just know the documentation; he's hit the edge cases, debugged the integrations,
          and knows what configuration decisions matter for business use.
        </p>
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          He also has 25+ years building and administering complex technical systems, from VoIP infrastructure
          in the late '90s to enterprise deployments at Microsoft and Accenture.
        </p>
        <p class="text-sm text-gray-700 leading-relaxed">
          For Seattle-area clients, setup is available on-site. He'll come to your office, configure everything
          on your hardware, and walk you and your team through using it before he leaves.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#0E1F3D" class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-serif text-3xl font-bold text-white mb-4">Ready to run your own AI agent system?</h2>
      <p class="text-lg mb-8 max-w-xl mx-auto" style="color:#8fa6c4">
        Start with a free 30-minute call. Aaron will ask about your setup, your goals, and tell you honestly
        whether this makes sense for you right now.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-4 rounded text-base font-semibold text-white transition-colors"
        style="background:#C08B3A"
        onmouseover="this.style.background='#D4A254'"
        onmouseout="this.style.background='#C08B3A'"
      >
        Book a Free Discovery Call
      </a>
      <p class="mt-6 text-sm" style="color:#5f7fa0">
        In-person setup available for Seattle and the greater Puget Sound area.
      </p>
    </div>
  </section>
</Layout>
