{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel0 \b \fs36 7. Data Models\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 7.1 SQLite Schema\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.1.1 Gateways Table\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 CREATE TABLE gateways (\line
    id           TEXT PRIMARY KEY,     -- UUID string\line
    label        TEXT NOT NULL,        -- "Home Server"\line
    url          TEXT NOT NULL,        -- "https://ubuntu-ct.tailb4a099.ts.net"\line
    token_ref    TEXT NOT NULL,        -- Keychain service+account key\line
    is_active    INTEGER NOT NULL DEFAULT 0,\line
    created_at   INTEGER NOT NULL,     -- Unix timestamp\line
    last_seen    INTEGER              -- Last successful connection\line
);\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.1.2 Sessions Table\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 CREATE TABLE sessions (\line
    id              TEXT PRIMARY KEY,  -- Gateway-assigned session ID\line
    gateway_id      TEXT NOT NULL REFERENCES gateways(id) ON DELETE CASCADE,\line
    label           TEXT,              -- User-facing name or null (auto-named)\line
    first_message   TEXT,              -- Cache of first message for preview\line
    last_activity   INTEGER NOT NULL,  -- Unix timestamp\line
    message_count   INTEGER NOT NULL DEFAULT 0,\line
    is_archived     INTEGER NOT NULL DEFAULT 0,\line
    last_synced_at  INTEGER,           -- When we last fetched from gateway\line
    created_at      INTEGER NOT NULL\line
);\line
\line
CREATE INDEX sessions_gateway_id ON sessions(gateway_id);\line
CREATE INDEX sessions_last_activity ON sessions(last_activity DESC);\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.1.3 Messages Table\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 CREATE TABLE messages (\line
    id              TEXT PRIMARY KEY,  -- Gateway-assigned or client-generated ID\line
    session_id      TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,\line
    role            TEXT NOT NULL,     -- "user" | "assistant" | "system"\line
    content         TEXT NOT NULL,     -- Full rendered content (markdown source)\line
    content_type    TEXT NOT NULL DEFAULT 'text',  -- "text" | "image" | "file"\line
    status          TEXT NOT NULL DEFAULT 'complete',\line
                                       -- "sending" | "sent" | "complete" | "error"\line
    is_streaming    INTEGER NOT NULL DEFAULT 0,\line
    stream_buffer   TEXT,              -- Partial content during streaming\line
    attachment_path TEXT,              -- Remote workspace path for attached files\line
    created_at      INTEGER NOT NULL,\line
    completed_at    INTEGER\line
);\line
\line
CREATE INDEX messages_session_id ON messages(session_id);\line
CREATE INDEX messages_created_at ON messages(session_id, created_at);\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.1.4 Work Events Table (Phase 2)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 CREATE TABLE work_events (\line
    id            TEXT PRIMARY KEY,    -- Gateway event ID\line
    session_id    TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,\line
    message_id    TEXT,                -- Associated assistant message if any\line
    event_kind    TEXT NOT NULL,       -- "tool_call" | "subagent_spawn" | etc.\line
    tool_name     TEXT,                -- e.g. "Read", "exec"\line
    args_json     TEXT,                -- JSON blob of tool args\line
    result_json   TEXT,                -- JSON blob of result (on complete)\line
    status        TEXT NOT NULL DEFAULT 'running',\line
                                       -- "running" | "complete" | "error"\line
    error_message TEXT,\line
    duration_ms   INTEGER,\line
    created_at    INTEGER NOT NULL,\line
    completed_at  INTEGER\line
);\line
\line
CREATE INDEX work_events_session_id ON work_events(session_id, created_at);\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 7.1.5 Artifacts Table (Phase 2)\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 CREATE TABLE artifacts (\line
    id            TEXT PRIMARY KEY,    -- UUID\line
    gateway_id    TEXT NOT NULL REFERENCES gateways(id) ON DELETE CASCADE,\line
    session_id    TEXT,                -- Optional: associated session\line
    remote_path   TEXT NOT NULL,       -- Full path on gateway workspace\line
    filename      TEXT NOT NULL,\line
    mime_type     TEXT,\line
    size_bytes    INTEGER,\line
    last_modified INTEGER,\line
    local_cache   TEXT,                -- Local path if cached\line
    cached_at     INTEGER,\line
    UNIQUE(gateway_id, remote_path)\line
);\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel1 \b \fs32 7.2 Swift Model Types\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 struct Gateway: Codable, Identifiable \{\line
    var id: UUID\line
    var label: String\line
    var url: URL\line
    var tokenRef: String        // Key into Keychain, NOT the token\line
    var isActive: Bool\line
    var createdAt: Date\line
    var lastSeen: Date?\line
\}\line
\line
struct Session: Codable, Identifiable \{\line
    var id: String\line
    var gatewayId: UUID\line
    var label: String?\line
    var firstMessage: String?\line
    var lastActivity: Date\line
    var messageCount: Int\line
    var isArchived: Bool\line
    var createdAt: Date\line
    \line
    var displayLabel: String \{\line
        label ?? firstMessage?.prefix(40).description ?? "New Session"\line
    \}\line
\}\line
\line
struct Message: Codable, Identifiable \{\line
    var id: String\line
    var sessionId: String\line
    var role: MessageRole\line
    var content: String\line
    var contentType: ContentType\line
    var status: MessageStatus\line
    var isStreaming: Bool\line
    var streamBuffer: String?\line
    var attachmentPath: String?\line
    var createdAt: Date\line
    var completedAt: Date?\line
\}\line
\line
enum MessageRole: String, Codable \{\line
    case user, assistant, system\line
\}\line
\line
enum MessageStatus: String, Codable \{\line
    case sending, sent, complete, error\line
\}\line
\line
enum ContentType: String, Codable \{\line
    case text, image, file\line
\}\line
\line
struct WorkEvent: Codable, Identifiable \{\line
    var id: String\line
    var sessionId: String\line
    var messageId: String?\line
    var eventKind: WorkEventKind\line
    var toolName: String?\line
    var args: [String: AnyCodable]?\line
    var result: [String: AnyCodable]?\line
    var status: WorkEventStatus\line
    var errorMessage: String?\line
    var durationMs: Int?\line
    var createdAt: Date\line
    var completedAt: Date?\line
\}\line
\line
enum WorkEventKind: String, Codable \{\line
    case toolCall, subagentSpawn, subagentComplete\line
    case fileRead, fileWrite, webSearch, thinking, approvalRequest\line
\}\line
\line
enum WorkEventStatus: String, Codable \{\line
    case running, complete, error\line
\}\par}
